# Xiaomi oxygen - Audio
persist.vendor.audio.calfile0=/vendor/etc/acdbdata/Tutu/Tutu_Bluetooth_cal.acdb
persist.vendor.audio.calfile1=/vendor/etc/acdbdata/Tutu/Tutu_General_cal.acdb
persist.vendor.audio.calfile2=/vendor/etc/acdbdata/Tutu/Tutu_Global_cal.acdb
persist.vendor.audio.calfile3=/vendor/etc/acdbdata/Tutu/Tutu_Handset_cal.acdb
persist.vendor.audio.calfile4=/vendor/etc/acdbdata/Tutu/Tutu_Hdmi_cal.acdb
persist.vendor.audio.calfile5=/vendor/etc/acdbdata/Tutu/Tutu_Headset_cal.acdb
persist.vendor.audio.calfile6=/vendor/etc/acdbdata/Tutu/Tutu_Speaker_cal.acdb

# Xiaomi oxygen - Audio fluence
persist.vendor.audio.fluence.speaker=true
persist.vendor.audio.fluence.voicecall=true
persist.vendor.audio.fluence.voicecomm=false
persist.vendor.audio.fluence.voicerec=false
ro.vendor.audio.sdk.fluencetype=fluence
vendor.audio.feature.fluence.enable=true

# Xiaomi vince - Camera
persist.camera.HAL3.enabled=1

# Xiaomi vince - Bluetooth
bluetooth.sco.disable_enhanced_connection=true

# Xiaomi vince - Encryption
ro.crypto.volume.contents_mode=aes-256-xts

# Fingerprint
persist.vendor.fingerprint.type=rear
persist.qfp=false

# Xiaomi vince - SoC
ro.soc.manufacturer=Qualcomm
ro.soc.model=MSM8953